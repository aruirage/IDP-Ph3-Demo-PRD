# Copy to .env.local and fill your DeepSeek API key. .env.local is gitignored.
PRD_MODEL_CHAT_URL=https://api.deepseek.com/chat/completions
PRD_MODEL_NAME=deepseek-flash
PRD_MODEL_API_KEY=

# Vercel: connect Upstash Redis for shared edits, comments and release history.
# Alternatively KV_REST_API_URL and KV_REST_API_TOKEN are supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Use separate keys for production and preview deployments.
PRD_STORAGE_KEY=
